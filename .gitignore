# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# Jupyter
.ipynb_checkpoints/

# Data directories – track structure, not files
data/raw/*
data/processed/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# Splits – keep manifests (CSV/JSON), ignore copied image trees
data/splits/**/*.jpg
data/splits/**/*.jpeg
data/splits/**/*.png
data/splits/**/*.bmp
data/splits/**/*.tiff
data/splits/**/*.tif
!data/splits/.gitkeep

# Preprocessed – ignore large binary arrays, keep label map and stats
data/preprocessed/*.npy
data/preprocessed/**/*.npy
!data/preprocessed/.gitkeep

# Reports – keep .gitkeep and before/after PNGs (small); ignore generated JSONs/MDs
reports/*.json
reports/*.md
!reports/.gitkeep
!reports/before_after/.gitkeep

# Kaggle credentials
.kaggle/

# OS artefacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Person 2 - Archana Ulloju Ignore Rules
archana_person2/artifacts/fixtures/synthetic_dataset/images/
archana_person2/artifacts/features/*.npz
archana_person2/artifacts/models/*.joblib
.mplcache/
powershell.exe
powershell.cmd

# Person 2 — Phase 10 cleanup additions
# Generated artifact outputs (re-creatable from scripts; not source code)
archana_person2/artifacts/plots/*.png
archana_person2/artifacts/metrics/*.json
archana_person2/artifacts/metrics/*.csv
archana_person2/artifacts/features/*_meta.json
# Keep synthetic fixture manifests (small, text, used by tests)
!archana_person2/artifacts/fixtures/synthetic_dataset/label_map.json
!archana_person2/artifacts/fixtures/synthetic_dataset/split_summary.json
!archana_person2/artifacts/fixtures/synthetic_dataset/train.csv
!archana_person2/artifacts/fixtures/synthetic_dataset/val.csv
!archana_person2/artifacts/fixtures/synthetic_dataset/test.csv
